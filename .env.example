# Copy to .env and fill in. NEVER commit .env.
VITE_SITE_URL=https://your-domain.com

# Admin control panel — server-side only, never sent to the browser
ADMIN_EMAILS=you@example.com            # comma-separated; accounts are created on first start
ADMIN_PATH=/hq-change-me-to-something-random
ADMIN_INITIAL_PASSWORD=change-me        # used only when the admin account is first created

# Email via SMTP (Gmail: smtp.gmail.com, 465, your address, an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Payments in USD (checkout is simulated until a key is set)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
PAYSTACK_SECRET_KEY=

DEMO_MODE=1
DEBUG=
PORT=3001
